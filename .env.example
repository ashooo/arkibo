# Local PostgreSQL only. Do not commit real credentials.
DATABASE_URL=postgresql://scholarready:localdev@localhost:5432/scholarready

# Files are stored outside public/ and are ignored by Git.
UPLOAD_DIR=./data/uploads

# Confirm these values against the official Lumen event documentation.
LUMEN_API_BASE_URL=https://REPLACE_WITH_VERIFIED_HOST
LUMEN_OCR_PATH=/REPLACE_WITH_VERIFIED_PATH
LUMEN_API_KEY=REPLACE_LOCALLY_ONLY

# Optional authorized Meta Graph API access for announcement imports.
META_GRAPH_VERSION=
META_SCHOLARSHIP_PAGE_ID=
META_SCHOLARSHIP_ACCESS_TOKEN=
META_PLP_PAGE_ID=
META_PLP_ACCESS_TOKEN=

# Optional dedicated bot authorized by the Pasig Scholars Telegram channel.
TELEGRAM_PASIG_BOT_TOKEN=

